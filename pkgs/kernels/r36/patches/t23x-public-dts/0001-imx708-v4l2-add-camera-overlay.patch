From bc4c8a03409a21250d83265c090a83f12189a14f Mon Sep 17 00:00:00 2001
From: rlfishback <rlfishback@anduril.com>
Date: Mon, 15 Jun 2026 11:17:42 -0700
Subject: [PATCH] overlay: imx708: add minimal V4L2-raw IMX708-C overlay
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Adds tegra234-p3767-camera-p3768-imx708-v4l2-C.dts: a minimal device
tree overlay binding the upstream RPi imx708 driver
(drivers/media/i2c/imx708.c) to CAM1 (CSI port C) on the Orin Nano
dev kit (p3767/p3768).

Differs from the existing tegracam imx708-C overlay in that it omits
tegra-camera-platform / module-badge metadata and all per-mode
register tables (mclk_khz / pix_clk_hz / line_length / mode_type /
etc.). Only the V4L2 OF-graph linkage is kept: sensor -> NVCSI
channel -> VI capture port. The graph wiring is mandatory —
without it, media_pipeline_start() has no path to walk from
/dev/videoN down to the sensor's .s_stream callback.

Mclk is routed through TEGRA234_CLK_EXTPERIPH2 at 24 MHz.  Trace:
tegra234 pinctrl pad PP.01 = extperiph2_clk_pp1, muxable to function
EXTPERIPH2; the p3767 BCT pinmux explicitly enables that pad before
kernel boot.  The p3768 carrier has two CSI camera connectors and
exactly two mclk pads (PP.00 -> EXTPERIPH1, PP.01 -> EXTPERIPH2);
they cannot be muxed onto a single connector.  Numerical convention
PP.0 -> CAM0, PP.1 -> CAM1 makes EXTPERIPH2 = CAM1_MCLK.  Final
confirmation requires the p3768 schematic or hardware dmesg.

Supplies all share a fixed dummy regulator mirroring the upstream
RPi pattern (cam module powers itself off the 3v3 connector rail).
---
 overlay/Makefile                              |   1 +
 ...ra234-p3767-camera-p3768-imx708-v4l2-C.dts | 178 ++++++++++++++++++
 2 files changed, 179 insertions(+)
 create mode 100644 overlay/tegra234-p3767-camera-p3768-imx708-v4l2-C.dts

diff --git a/overlay/Makefile b/overlay/Makefile
index c5b0cad..f787b05 100644
--- a/overlay/Makefile
+++ b/overlay/Makefile
@@ -66,6 +66,7 @@ dtbo-y += tegra234-p3767-camera-p3768-imx219-A.dtbo
 dtbo-y += tegra234-p3767-camera-p3768-imx219-imx477.dtbo
 dtbo-y += tegra234-p3767-camera-p3768-imx477-C.dtbo
 dtbo-y += tegra234-p3767-camera-p3768-imx477-A.dtbo
+dtbo-y += tegra234-p3767-camera-p3768-imx708-v4l2-C.dtbo
 
 ifneq ($(dtb-y),)
 dtb-y := $(addprefix $(makefile-path)/,$(dtb-y))
diff --git a/overlay/tegra234-p3767-camera-p3768-imx708-v4l2-C.dts b/overlay/tegra234-p3767-camera-p3768-imx708-v4l2-C.dts
new file mode 100644
index 0000000..f6f8b91
--- /dev/null
+++ b/overlay/tegra234-p3767-camera-p3768-imx708-v4l2-C.dts
@@ -0,0 +1,178 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// SPDX-FileCopyrightText: Copyright (c) 2026 Anduril Industries, Inc.
+
+/*
+ * Minimal V4L2-raw IMX708 overlay for Jetson Orin Nano dev kit (p3767/p3768),
+ * CSI port C (CAM1, J21 22-pin connector). Targets the upstream RPi imx708
+ * driver (drivers/media/i2c/imx708.c) — NOT the RidgeRun tegracam fork.
+ *
+ * Differs from the existing tegracam IMX708-C overlay in that it omits
+ * tegra-camera-platform / module-badge metadata and all per-mode register
+ * tables (mclk_khz / pix_clk_hz / line_length / mode_type / etc.). Only
+ * the V4L2 OF-graph linkage is kept: sensor -> NVCSI channel -> VI capture
+ * port. The graph wiring is mandatory — without it,
+ * media_pipeline_start() has no path to walk from /dev/videoN down to the
+ * sensor's .s_stream callback, even though VIDIOC_STREAMON would succeed
+ * at the VI level. (libcamera's simple pipeline handler is a separate,
+ * userspace concern; see bd imx708-hy2 for why it can't bind on Tegra234
+ * NVCSI under JP6.x.)
+ */
+
+/dts-v1/;
+/plugin/;
+
+#define CAM0_RST	TEGRA234_MAIN_GPIO(H, 3)
+#define CAM0_PWDN	TEGRA234_MAIN_GPIO(H, 6)
+#define CAM1_PWDN	TEGRA234_MAIN_GPIO(AC, 0)
+#define CAM_I2C_MUX	TEGRA234_AON_GPIO(CC, 3)
+
+#include <dt-bindings/tegra234-p3767-0000-common.h>
+#include <dt-bindings/clock/tegra234-clock.h>
+
+/ {
+	overlay-name = "Camera IMX708-V4L2-C";
+	jetson-header-name = "Jetson 22pin CSI Connector";
+	compatible = JETSON_COMPATIBLE_P3768;
+
+	fragment@0 {
+		target-path = "/";
+		__overlay__ {
+			cam_dummy_reg: cam_dummy_reg {
+				compatible = "regulator-fixed";
+				regulator-name = "cam-dummy-reg";
+				status = "okay";
+			};
+
+			tegra-capture-vi {
+				num-channels = <1>;
+				ports {
+					#address-cells = <1>;
+					#size-cells = <0>;
+					vi_port1: port@1 {
+						reg = <0>;
+						imx708_vi_in_c: endpoint {
+							port-index = <2>;
+							bus-width = <2>;
+							remote-endpoint = <&imx708_csi_out_c>;
+						};
+					};
+				};
+			};
+
+			bus@0 {
+				host1x@13e00000 {
+					nvcsi@15a00000 {
+						num-channels = <1>;
+						#address-cells = <1>;
+						#size-cells = <0>;
+						csi_chan1: channel@1 {
+							reg = <0>;
+							ports {
+								#address-cells = <1>;
+								#size-cells = <0>;
+								csi_chan1_port0: port@0 {
+									reg = <0>;
+									imx708_csi_in_c: endpoint@2 {
+										port-index = <2>;
+										bus-width = <2>;
+										remote-endpoint = <&imx708_ep_c>;
+									};
+								};
+								csi_chan1_port1: port@1 {
+									reg = <1>;
+									imx708_csi_out_c: endpoint@3 {
+										remote-endpoint = <&imx708_vi_in_c>;
+									};
+								};
+							};
+						};
+					};
+				};
+
+				cam_i2cmux {
+					status = "okay";
+					compatible = "i2c-mux-gpio";
+					#address-cells = <1>;
+					#size-cells = <0>;
+					mux-gpios = <&gpio_aon CAM_I2C_MUX GPIO_ACTIVE_HIGH>;
+					i2c-parent = <&cam_i2c>;
+					i2c@1 {
+						status = "okay";
+						reg = <1>;
+						#address-cells = <1>;
+						#size-cells = <0>;
+
+						imx708_c: camera-sensor@1a {
+							compatible = "sony,imx708";
+							reg = <0x1a>;
+							status = "okay";
+
+							/*
+							 * mclk routing — EXTPERIPH2 is CAM1_MCLK.
+							 *
+							 * Trace: tegra234 pinctrl driver
+							 * (drivers/pinctrl/tegra/pinctrl-tegra234.c)
+							 * defines silicon pad PP.01 = extperiph2_clk_pp1,
+							 * muxable to function EXTPERIPH2 (= TEGRA234_CLK_EXTPERIPH2).
+							 * The p3767 BCT pinmux explicitly enables that pad with
+							 * function "extperiph2" before kernel boot. The p3768
+							 * carrier has exactly two CSI camera connectors
+							 * (CAM0, CAM1) and the BCT enables exactly two mclk
+							 * pads (PP.00 -> EXTPERIPH1, PP.01 -> EXTPERIPH2);
+							 * they cannot be muxed onto a single connector
+							 * (cam_i2c IS GPIO-muxed via CAM_I2C_MUX, mclks are
+							 * not). Numerical convention PP.0 -> CAM0,
+							 * PP.1 -> CAM1 then makes EXTPERIPH2 = CAM1_MCLK.
+							 *
+							 * Final confirmation requires the p3768 schematic or
+							 * dmesg on hardware (imx708 driver verifies 24MHz at
+							 * probe).
+							 */
+							clocks = <&bpmp TEGRA234_CLK_EXTPERIPH2>;
+							clock-names = "inclk";
+							assigned-clocks = <&bpmp TEGRA234_CLK_EXTPERIPH2>;
+							assigned-clock-rates = <24000000>;
+
+							vana1-supply = <&cam_dummy_reg>;
+							vana2-supply = <&cam_dummy_reg>;
+							vdig-supply  = <&cam_dummy_reg>;
+							vddl-supply  = <&cam_dummy_reg>;
+
+							reset-gpios = <&gpio CAM1_PWDN GPIO_ACTIVE_HIGH>;
+
+							port {
+								imx708_ep_c: endpoint {
+									port-index = <2>;
+									bus-width = <2>;
+									data-lanes = <1 2>;
+									clock-lanes = <0>;
+									clock-noncontinuous;
+									link-frequencies =
+										/bits/ 64 <450000000>;
+									remote-endpoint = <&imx708_csi_in_c>;
+								};
+							};
+						};
+					};
+				};
+
+				gpio@2200000 {
+					camera-control-output-low {
+						gpio-hog;
+						output-low;
+						gpios = <CAM0_RST 0>;
+						label = "cam0-rst";
+					};
+				};
+				gpio@6000d000 {
+					camera-control-output-low {
+						gpio-hog;
+						output-low;
+						gpios = < CAM1_PWDN 0  CAM0_PWDN 0>;
+						label = "cam1-pwdn", "cam0-pwdn";
+					};
+				};
+			};
+		};
+	};
+};
-- 
